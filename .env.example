# Environment
NODE_ENV=development

# Service
SERVICE_NAME=subscription-service
LOG_LEVEL=info

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Database (AWS)
# DB_TABLE_NAME=subscription-service-dev

# Database (Azure)
# DB_CONTAINER_NAME=subscriptions

# External Services
IDENTITY_SERVICE_BASE_URL=https://identity-service.example.com

# Feature Flags
FEATURE_FLAG_CRM_ADAPTER=false
