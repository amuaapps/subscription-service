{
  "name": "subscription-service",
  "version": "1.1.0",
  "description": "A serverless microservice for managing subscriptions",
  "main": "dist/index.js",
  "type": "commonjs",
  "scripts": {
    "build": "tsc",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\" --ext .ts",
    "lint:fix": "eslint \"src/**/*.ts\" \"tests/**/*.ts\" --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" || true",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" || true",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:unit": "jest tests/unit",
    "test:integration": "jest tests/integration",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch",
    "clean": "rm -rf dist coverage",
    "prebuild": "npm run clean",
    "prepare": "husky install || true"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amuaapps/subscription-service.git"
  },
  "keywords": [
    "subscription",
    "microservice",
    "serverless",
    "typescript",
    "aws",
    "azure"
  ],
  "author": "Amua Apps",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/amuaapps/subscription-service/issues"
  },
  "homepage": "https://github.com/amuaapps/subscription-service#readme",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.6",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "husky": "^8.0.3",
    "jest": "^29.7.0",
    "lint-staged": "^15.2.0",
    "prettier": "^3.1.1",
    "ts-jest": "^29.1.1",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "zod": "^3.22.4"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
